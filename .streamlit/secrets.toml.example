# Streamlit Secrets Configuration Template
# =========================================
# To enable real Google OAuth in your application:
# 1. Duplicate this file and rename it to `secrets.toml` inside the `.streamlit/` folder.
# 2. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials).
# 3. Create an "OAuth 2.0 Client ID" with application type "Web application".
# 4. Under "Authorized JavaScript origins", add:
#      - https://data-studio-analyst15.streamlit.app/
#      - https://<your-app-name>.streamlit.app (for Streamlit Community Cloud)
# 5. Under "Authorized redirect URIs", add:
#      - https://data-studio-analyst15.streamlit.app/oauth2callback
#      - https://<your-app-name>.streamlit.app/oauth2callback
# 6. Copy your Client ID and Client Secret into the fields below.
# 7. Generate a secure 32-byte random hex string for cookie_secret:
#      python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "https://data-studio-analyst15.streamlit.app/oauth2callback"
cookie_secret = "CHANGE_ME_TO_A_SECURE_RANDOM_32_BYTE_HEX"

[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
